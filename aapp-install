#!/usr/bin/env bash
# ==============================================================================
# Asymmetric Agent Planning Protocol (AAPP) - Global Installer (`aapp-install`)
#
# Installs `aapp-init` and `aapp-install` to `$HOME/.local/bin/` and copies
# templates and test suites to `${XDG_DATA_HOME:-$HOME/.local/share}/aapp-kit/`.
#
# Consumes the temporary clone folder once installation is complete.
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/aapp-kit"
BIN_DIR="$HOME/.local/bin"

# ------------------------------------------------------------------------------
# 1. Flags & Options
# ------------------------------------------------------------------------------
for ARG in "$@"; do
    case "$ARG" in
        --uninstall)
            echo "🗑️  Uninstalling AAPP global tools..."
            REMOVED_ANY=0
            for BIN in "$BIN_DIR/aapp-init" "$BIN_DIR/aapp-install"; do
                if [ -f "$BIN" ]; then
                    rm -f "$BIN"
                    echo "   • Removed $BIN"
                    REMOVED_ANY=1
                fi
            done
            if [ -d "$SHARE_DIR" ]; then
                rm -rf "$SHARE_DIR"
                echo "   • Removed $SHARE_DIR"
                REMOVED_ANY=1
            fi

            if [ "$REMOVED_ANY" -eq 1 ]; then
                echo "✨ Uninstallation complete."
                echo "ℹ️  Note: Any PATH export lines added to your shell rc file were left untouched."
            else
                echo "ℹ️  No AAPP installation found in $BIN_DIR or $SHARE_DIR."
            fi
            exit 0
            ;;
        -h|--help)
            echo "Usage: aapp-install [--uninstall]"
            echo ""
            echo "  Installs aapp-init and aapp-install globally into ~/.local/bin/ and"
            echo "  copies templates/tests to ~/.local/share/aapp-kit/."
            echo ""
            echo "  Note: This command consumes the temporary aapp-kit clone upon success."
            echo "  Copy the folder first if you wish to retain a local source checkout."
            echo ""
            echo "Options:"
            echo "  --uninstall   Remove installed binaries and share data"
            echo "  -h, --help    Show this help message and exit"
            exit 0
            ;;
        *)
            echo "❌ Unknown option: $ARG (try --help)"
            exit 1
            ;;
    esac
done

# ------------------------------------------------------------------------------
# 2. Verify Source Integrity
# ------------------------------------------------------------------------------
if [ ! -d "$SCRIPT_DIR/templates" ] || [ ! -f "$SCRIPT_DIR/templates/pre-commit" ]; then
    echo "❌ Error: templates/ not found next to this script ($SCRIPT_DIR)."
    echo "   Re-clone the full AAPP repository and run aapp-install from inside it."
    exit 1
fi

echo "🚀 Installing Asymmetric Agent Planning Protocol (AAPP)..."

# ------------------------------------------------------------------------------
# 3. Create Target Directories & Copy Files
# ------------------------------------------------------------------------------
BIN_CREATED=0
[ ! -d "$BIN_DIR" ] && BIN_CREATED=1

mkdir -p "$SHARE_DIR" "$BIN_DIR"

echo "📦 Copying templates and test suites to $SHARE_DIR..."
rm -rf "${SHARE_DIR:?}/templates" "${SHARE_DIR:?}/tests"
cp -r "$SCRIPT_DIR/templates" "$SHARE_DIR/"
[ -d "$SCRIPT_DIR/tests" ] && cp -r "$SCRIPT_DIR/tests" "$SHARE_DIR/"

echo "🔧 Installing binaries into $BIN_DIR..."
cp "$SCRIPT_DIR/aapp-init" "$BIN_DIR/aapp-init"
chmod +x "$BIN_DIR/aapp-init"

cp "$SCRIPT_DIR/aapp-install" "$BIN_DIR/aapp-install"
chmod +x "$BIN_DIR/aapp-install"

# ------------------------------------------------------------------------------
# 4. PATH Configuration & Shell Detection
# ------------------------------------------------------------------------------
PATH_OK=0
case ":$PATH:" in
    *":$BIN_DIR:"*) PATH_OK=1 ;;
esac

SHELL_NAME="$(basename "${SHELL:-bash}")"

if [ "$PATH_OK" -eq 1 ]; then
    echo "✅ '$BIN_DIR' is already in your PATH."
elif [ "$BIN_CREATED" -eq 1 ]; then
    echo "ℹ️  Created '$BIN_DIR'. On many systems (Debian/Ubuntu/macOS), logging out and"
    echo "   back in will automatically add it to your PATH."
else
    # Determine candidate RC file
    case "$SHELL_NAME" in
        zsh)  RC_FILE="$HOME/.zshrc" ;;
        fish) RC_FILE="$HOME/.config/fish/config.fish" ;;
        *)    RC_FILE="$HOME/.bashrc" ;;
    esac

    RC_ALREADY_CONFIGURED=0
    if [ -f "$RC_FILE" ] && grep -qs '\.local/bin' "$RC_FILE"; then
        RC_ALREADY_CONFIGURED=1
    elif [ -f "$HOME/.profile" ] && grep -qs '\.local/bin' "$HOME/.profile"; then
        RC_ALREADY_CONFIGURED=1
    fi

    if [ "$RC_ALREADY_CONFIGURED" -eq 1 ]; then
        echo "ℹ️  '$BIN_DIR' is referenced in your profile/rc file."
        echo "   Restart your shell or run: source $RC_FILE"
    elif [ "$SHELL_NAME" = "fish" ]; then
        echo "ℹ️  To add to PATH in fish shell, run:"
        echo "     fish_add_path ~/.local/bin"
    elif [ -t 0 ]; then
        printf "❓ Add '$BIN_DIR' to PATH in %s? [y/N] " "$RC_FILE"
        read -r REPLY
        case "$REPLY" in
            [yY]|[yY][eE][sS])
                echo "" >> "$RC_FILE"
                echo "# Added by AAPP installer" >> "$RC_FILE"
                echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$RC_FILE"
                echo "📝 Added export to $RC_FILE. Run: source $RC_FILE"
                ;;
            *)
                echo "ℹ️  Skipped rc edit. You can add it manually:"
                echo '     export PATH="$HOME/.local/bin:$PATH"'
                ;;
        esac
    else
        echo "ℹ️  To use 'aapp-init' globally, ensure '$BIN_DIR' is in your PATH:"
        echo '     export PATH="$HOME/.local/bin:$PATH"'
    fi
fi

# ------------------------------------------------------------------------------
# 5. Consume Temporary Clone Folder
# ------------------------------------------------------------------------------
if [ "$(basename "$SCRIPT_DIR")" != "agent-planning-kit" ]; then
    rm -rf "$SCRIPT_DIR"
    echo ""
    echo "🧹 Consumed installer directory '$SCRIPT_DIR'."
fi

echo ""
echo "✨ AAPP successfully installed!"
echo "➡️  Binary:   $BIN_DIR/aapp-init"
echo "➡️  Share:    $SHARE_DIR"
echo ""
echo "To initialize any git project with AAPP, run from your project root:"
echo "  aapp-init"

#!/usr/bin/env bash
# ==============================================================================
# Asymmetric Agent Planning Protocol (AAPP CLI)
#
# Primary executable and dispatcher.
# ==============================================================================
set -e

AAPP_VERSION="0.9.0"
AAPP_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ------------------------------------------------------------------------------
# 1. Base Resolution (Templates & Libraries)
# ------------------------------------------------------------------------------
has_kit_signature() {
    local dir="$1"
    [ -d "$dir/templates" ] && \
    [ -f "$dir/templates/pre-commit" ] && \
    [ -f "$dir/templates/AGENTS.md" ] && \
    [ -d "$dir/lib" ] && \
    [ -f "$dir/lib/cmd_init.sh" ]
}

is_safe_to_consume_kit_dir() {
    local dir="$1"

    [ ! -d "$dir" ] && return 1

    case "$(basename "$dir")" in
        aapp-develop-kit|agent-planning-kit)
            return 1
            ;;
    esac

    if ! has_kit_signature "$dir"; then
        return 1
    fi

    local item base
    for item in "$dir"/* "$dir"/.*; do
        [ ! -e "$item" ] && [ ! -L "$item" ] && continue
        base="$(basename "$item")"
        case "$base" in
            .|..) continue ;;
            aapp|lib|templates|tests|examples|scripts) continue ;;
            README*|MANUAL*|CHEATSHEET*|CHANGELOG*|LICENSE*|COPYING*|CODEMAP*|ARCHITECTURE*) continue ;;
            .git*|.agents|.plans|.githooks|.claude|.cursor|.gemini|.github) continue ;;
            *)
                return 1
                ;;
        esac
    done

    if [ -d "$dir/.git" ] || git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local git_status
        git_status="$(git -C "$dir" status --porcelain 2>/dev/null || true)"
        if [ -n "$git_status" ]; then
            return 1
        fi
    fi

    return 0
}

if has_kit_signature "$AAPP_SCRIPT_DIR"; then
    AAPP_BASE="$AAPP_SCRIPT_DIR"
    AAPP_RUNTIME="local"
elif [ -n "${XDG_DATA_HOME:-}" ] && has_kit_signature "$XDG_DATA_HOME/aapp-kit"; then
    AAPP_BASE="$XDG_DATA_HOME/aapp-kit"
    AAPP_RUNTIME="installed"
elif [ -d "$HOME/.local/share/aapp-kit" ] && has_kit_signature "$HOME/.local/share/aapp-kit"; then
    AAPP_BASE="$HOME/.local/share/aapp-kit"
    AAPP_RUNTIME="installed"
else
    # Allow version and help without full libraries if needed
    case "${1:-}" in
        version|-v|--version)
            echo "aapp version $AAPP_VERSION"
            exit 0
            ;;
        help|-h|--help)
            echo "AAPP v$AAPP_VERSION (templates not found locally)."
            echo "Run 'git clone https://github.com/aapp-protocol/aapp-kit.git && ./aapp-kit/aapp install'"
            exit 0
            ;;
    esac

    echo "❌ Error: AAPP shared libraries not found."
    echo "   Looked in:"
    echo "     • $AAPP_SCRIPT_DIR/lib"
    echo "     • ${XDG_DATA_HOME:-$HOME/.local/share}/aapp-kit/lib"
    echo ""
    echo "   To install AAPP globally on this system, run:"
    echo "     git clone https://github.com/aapp-protocol/aapp-kit.git"
    echo "     ./aapp-kit/aapp install"
    echo ""
    exit 1
fi

AAPP_LIB="$AAPP_BASE/lib"
AAPP_TEMPLATES="$AAPP_BASE/templates"

export AAPP_VERSION AAPP_BASE AAPP_LIB AAPP_TEMPLATES AAPP_RUNTIME AAPP_SCRIPT_DIR

# ------------------------------------------------------------------------------
# 2. Command Dispatcher
# ------------------------------------------------------------------------------
CMD="${1:-help}"
shift || true

# `aapp <verb> help` is `aapp help <verb>` (P-87): answered here, so no verb
# takes the word as a slug, an id or a reason. Also routes action plugins (P-95).
# While AAPP verbs strictly reject dash-flags, catching -h and --help here
# routes to help before verbs consume them as positional data (e.g. commit messages).
case "${1:-}" in
    help|-h|--help)
        HELP_FULL=""
        if [ "$#" -eq 2 ] && [ "${2:-}" = "full" ]; then
            HELP_FULL="full"
        fi
        if { [ "$#" -eq 1 ] || [ -n "$HELP_FULL" ]; } && \
           [ "$CMD" != "help" ] && [ "$CMD" != "-h" ] && [ "$CMD" != "--help" ]; then
            CWD_GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
            if grep -q "^$CMD$(printf '\t')" "$AAPP_LIB/verbs.tsv" 2>/dev/null || \
               { [ -n "$CWD_GIT_ROOT" ] && [ -d "$CWD_GIT_ROOT/.agents/skills/$CMD" ]; }; then
                source "$AAPP_LIB/cmd_help.sh" "$CMD" ${HELP_FULL:+"$HELP_FULL"}
                exit 0
            fi
        fi
        ;;
esac

# ------------------------------------------------------------------------------
# 2a. Repository Root Assertion (P-33)
#
# Operational verbs require a Git repository. Asserting once here — rather than
# re-deriving REPO_ROOT in every sourced subcommand with a silent `|| pwd`
# fallback — means a non-repo invocation fails closed with a diagnostic instead
# of quietly treating $PWD as the repository root.
# ------------------------------------------------------------------------------
case "$CMD" in
    version|-v|--version|help|-h|--help|install|upgrade|update|uninstall|develop)
        # Exempt: pure terminal output or machine-level installers
        ;;
    *)
        if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
            echo "❌ Error: 'aapp $CMD' must be run inside a Git repository." >&2
            exit 1
        fi
        AAPP_REPO_ROOT="$REPO_ROOT"
        export REPO_ROOT AAPP_REPO_ROOT
        ;;
esac

# ------------------------------------------------------------------------------
# 2b. Plugin step (P-77)
#
# A supported plugin is called during a step of a verb that holds its lock and
# may be mid-commit. A verb that changes the project, run from inside that step,
# is refused: the plugin writes the command to its `do` list and the kit runs it
# once the step is over. Verbs that only read are let through.
# ------------------------------------------------------------------------------
if [ -n "${AAPP_PLUGIN_STEP:-}" ]; then
    case "$CMD ${1:-}" in
        "status "*|"plan-status "*|"plugins "*|"plugin-status "*|"hooks "*|"hook-status "*) ;;
        "version "*|"-v "*|"--version "*|"help "*|"-h "*|"--help "*) ;;
        "issue list"|"note show"|"matrix check"|"companion list"|"companion status"*) ;;
        *)
            echo "❌ [Plugin] 'aapp $CMD${1:+ $1}' changes the project and cannot run during a plugin step ($AAPP_PLUGIN_STEP)." >&2
            echo "   Write the command to the do list instead; the kit runs it after the step:" >&2
            echo "     echo '$CMD${1:+ $1} …' >> \"\$AAPP_PLUGIN_DO\"" >&2
            exit 1
            ;;
    esac
fi

case "$CMD" in
    init)
        source "$AAPP_LIB/cmd_init.sh" "$@"
        ;;
    install)
        source "$AAPP_LIB/cmd_install.sh" "$@"
        ;;
    develop)
        source "$AAPP_LIB/cmd_develop.sh" "$@"
        ;;
    upgrade|update)
        source "$AAPP_LIB/cmd_upgrade.sh" "$@"
        ;;
    uninstall)
        source "$AAPP_LIB/cmd_uninstall.sh" "$@"
        ;;
    status)
        source "$AAPP_LIB/cmd_status.sh" "$@"
        ;;
    ai)
        source "$AAPP_LIB/cmd_ai.sh" "$@"
        ;;
    commit)
        source "$AAPP_LIB/cmd_commit.sh"
        cmd_commit "$@"
        ;;
    note)
        source "$AAPP_LIB/cmd_note.sh"
        cmd_note "$@"
        ;;
    issue)
        source "$AAPP_LIB/cmd_issue.sh"
        cmd_issue "$@"
        ;;
    companion)
        source "$AAPP_LIB/cmd_companion.sh"
        cmd_companion "$@"
        ;;
    offline)
        source "$AAPP_LIB/cmd_offline.sh"
        cmd_offline "$@"
        ;;
    draft|refine|freeze-start|start|freeze|done|plan|active|plan-status|tdd)
        source "$AAPP_LIB/cmd_plan.sh" "$CMD" "$@"
        ;;
    matrix)
        source "$AAPP_LIB/cmd_matrix.sh" "$@"
        ;;
    test)
        source "$AAPP_LIB/cmd_test.sh"
        cmd_test "$@"
        ;;
    pause|resume|unpause)
        source "$AAPP_LIB/cmd_pause.sh" "$CMD" "$@"
        ;;
    push|pull|sync)
        source "$AAPP_LIB/cmd_sync.sh" "$CMD" "$@"
        ;;
    hooks|hook-status|plugins|plugin-status|hook-test|hook-run|hook-hash)
        source "$AAPP_LIB/cmd_hook.sh" "$CMD" "$@"
        ;;
    release)
        source "$AAPP_LIB/cmd_release.sh"
        cmd_release "$@"
        ;;
    version|-v|--version)
        echo "aapp version $AAPP_VERSION"
        exit 0
        ;;
    help|-h|--help)
        source "$AAPP_LIB/cmd_help.sh" "$@"
        exit 0
        ;;
    *)
        # Action Plugin Fallthrough (.agents/skills/$CMD/)
        case "$CMD" in
            *.sample) exit 127 ;; # Do not execute sample plugins directly
        esac
        CWD_GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
        if [ -n "$CWD_GIT_ROOT" ] && [ -d "$CWD_GIT_ROOT/.agents/skills/$CMD" ]; then
            PLUGIN_DIR="$CWD_GIT_ROOT/.agents/skills/$CMD"
            CANDIDATE=""
            if command -v resolve_plugin_entrypoint >/dev/null 2>&1; then
                CANDIDATE="$(resolve_plugin_entrypoint "$PLUGIN_DIR" "$CMD" || true)"
            elif [ -f "$AAPP_LIB/hook_dispatcher.sh" ]; then
                # shellcheck source=/dev/null
                source "$AAPP_LIB/hook_dispatcher.sh"
                CANDIDATE="$(resolve_plugin_entrypoint "$PLUGIN_DIR" "$CMD" || true)"
            fi
            if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ]; then
                export AAPP_REPO_ROOT="$CWD_GIT_ROOT"
                export REPO_ROOT="$CWD_GIT_ROOT"
                exec "$CANDIDATE" "$@"
            fi
        fi

        echo "❌ Unknown command: '$CMD'"
        echo ""
        source "$AAPP_LIB/cmd_help.sh"
        exit 1
        ;;
esac

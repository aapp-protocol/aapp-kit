#!/usr/bin/env bash
# ==============================================================================
# Asymmetric Agent Planning Protocol (AAPP) - Git Pre-Commit Hook
#
# 1. CHANGELOG.md Enforcement (Blocking for source code changes)
# 2. Deterministic Blast Radius Enforcement (Validates staged files against .plans/current/*.md)
# 3. Documentation Invariant Reminders (Non-blocking warning)
# 4. Extensible Syntax & Linter Validations (PHP, JS/TS, Python, JSON schemas, etc.)
# ==============================================================================
set -e

# Escape hatch (runs first)
if [ "${SKIP_BLAST_RADIUS:-0}" = "1" ]; then
    echo "⚡ [Pre-Commit Notice] Blast Radius and CHANGELOG verification skipped via SKIP_BLAST_RADIUS=1."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# Staged files list (NUL-safe array) - includes additions, modifications, and deletions
STAGED_FILES=()
while IFS= read -r -d '' FILE; do
    [ -n "$FILE" ] && STAGED_FILES+=("$FILE")
done < <(git diff --cached --name-only -z --diff-filter=ACMRD)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

# ------------------------------------------------------------------------------
# 0. ADAPTIVE BRANCH PROTECTION (STABLE VS. EDGE GUARD)
# ------------------------------------------------------------------------------
if [ "${ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
    PROTECT_STABLE="$(git config --bool aapp.protectStable 2>/dev/null || echo "true")"
    if [ "$PROTECT_STABLE" != "false" ]; then
        CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"
        if [ -n "$CURRENT_BRANCH" ]; then
            PROTECTED_BRANCHES="$(git config aapp.protectedBranches 2>/dev/null || echo "main master production")"
            DEV_BRANCHES="$(git config aapp.devBranch 2>/dev/null || echo "develop dev development")"

            IS_PROTECTED=0
            for PB in $PROTECTED_BRANCHES; do
                if [ "$CURRENT_BRANCH" = "$PB" ]; then
                    IS_PROTECTED=1
                    break
                fi
            done

            if [ "$IS_PROTECTED" -eq 1 ]; then
                # Probe if an active development branch exists (local or remote tracking)
                DEV_BRANCH_FOUND=""
                for DB in $DEV_BRANCHES; do
                    if git show-ref --verify --quiet "refs/heads/$DB" 2>/dev/null || \
                       git show-ref --verify --quiet "refs/remotes/origin/$DB" 2>/dev/null || \
                       git show-ref --quiet -- "refs/remotes/*/$DB" 2>/dev/null; then
                        DEV_BRANCH_FOUND="$DB"
                        break
                    fi
                done

                if [ -n "$DEV_BRANCH_FOUND" ]; then
                    echo ""
                    echo "❌ [AAPP Branch Protection] Direct commits to '$CURRENT_BRANCH' are prohibited!"
                    echo "   A development branch ('$DEV_BRANCH_FOUND') exists for active engineering."
                    echo ""
                    echo "   👉 Switch to your development branch before committing:"
                    echo "      git checkout $DEV_BRANCH_FOUND"
                    echo ""
                    echo "   💡 If this is an intentional release or hotfix commit on '$CURRENT_BRANCH':"
                    echo "      ALLOW_MAIN_COMMIT=1 git commit -m \"...\""
                    echo "   💡 Or to disable branch protection for trunk-based development:"
                    echo "      git config --bool aapp.protectStable false"
                    echo ""
                    exit 1
                fi
            fi
        fi
    fi
fi

ALWAYS_ALLOWED_REGEX='^(CHANGELOG\.md|README\.md|MANUAL\.md|CHEATSHEET\.md|CODEMAP\.md|ARCHITECTURE\.md|ISSUES\.md|\.gitignore|package\.json|package-lock\.json|composer\.json|composer\.lock|go\.mod|go\.sum|Cargo\.toml|Cargo\.lock|pyproject\.toml|requirements\.txt)$'

CORE_CODE_REGEX='\.(php|js|jsx|ts|tsx|py|go|rs|c|cpp|h|hpp|java|rb|css|scss|sql|html|sh|bash|zsh)$|^schema/.*\.json$|^aapp$'

STAGED_CORE_COUNT=0
for F in "${STAGED_FILES[@]}"; do
    if echo "$F" | grep -qE "$CORE_CODE_REGEX"; then
        STAGED_CORE_COUNT=$((STAGED_CORE_COUNT + 1))
    fi
done

# ------------------------------------------------------------------------------
# 1. CHANGELOG.md ENFORCEMENT (BLOCKING FOR CORE CODE)
# ------------------------------------------------------------------------------
if [ "$STAGED_CORE_COUNT" -gt 0 ]; then
    CHANGELOG_UPDATED=0
    # Check if root CHANGELOG.md or .plans/CHANGELOG.md is staged in this commit
    for F in "${STAGED_FILES[@]}"; do
        if [ "$F" = "CHANGELOG.md" ] || [ "$F" = ".plans/CHANGELOG.md" ]; then
            CHANGELOG_UPDATED=1
            break
        fi
    done

    # If not staged in current git index, check if .plans/CHANGELOG.md exists in worktree and was updated
    if [ "$CHANGELOG_UPDATED" -eq 0 ] && [ -d ".plans" ]; then
        if git -C .plans rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            if git -C .plans status --porcelain 2>/dev/null | grep -qE 'CHANGELOG\.md'; then
                CHANGELOG_UPDATED=1
            elif git -C .plans log -1 --name-only --format="" 2>/dev/null | grep -qE '^CHANGELOG\.md$'; then
                CHANGELOG_UPDATED=1
            fi
        fi
    fi

    if [ "$CHANGELOG_UPDATED" -eq 0 ]; then
        echo ""
        echo "❌ [Pre-Commit Error] Core code files were modified, but CHANGELOG.md was not updated!"
        echo "   👉 Please document your changes in CHANGELOG.md (or .plans/CHANGELOG.md) and stage it:"
        echo "      git add CHANGELOG.md"
        echo ""
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# 2. DETERMINISTIC BLAST RADIUS ENFORCEMENT (BLOCKING WHEN ACTIVE PLANS EXIST)
# ------------------------------------------------------------------------------
ACTIVE_PLANS=""
if [ -d .plans/current ]; then
    NL='
'
    for plan_file in .plans/current/*.md; do
        [ ! -f "$plan_file" ] && continue
        case "$(basename "$plan_file")" in
            000-*) continue ;;
        esac
        if grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*(🔴|🟡|Under Review|Refining)' "$plan_file" 2>/dev/null; then
            continue
        fi
        ACTIVE_PLANS="${ACTIVE_PLANS:+$ACTIVE_PLANS$NL}$plan_file"
    done
fi

if [ -n "$ACTIVE_PLANS" ]; then
    # Helper to parse target paths from plan sections
    parse_plan_section() {
        local file="$1"
        local start_pattern="$2"
        local end_pattern="$3"
        
        awk -v start="$start_pattern" -v end="$end_pattern" '
            $0 ~ start { flag=1; next }
            $0 ~ end && flag { flag=0 }
            flag {
                line = $0
                sub(/^[[:space:]]*-[[:space:]]*\[[ xX]\][[:space:]]*/, "", line)
                sub(/^[[:space:]]*(`?(NEW FILE|MODIFY|DELETE|ADD|REPLACE)`?)?[[:space:]]*->[[:space:]]*/, "", line)
                if (match(line, /`[^`]+`/)) {
                    item = substr(line, RSTART+1, RLENGTH-2)
                    if (item !~ /^(NEW FILE|MODIFY|DELETE|ADD|REPLACE)$/) {
                        print item
                    }
                }
            }
        ' "$file"
    }

    glob_to_regex() {
        local p="$1"
        # 1. Escape regex metacharacters: \ . + ^ $ ( ) { } |
        p="${p//\\/\\\\}"
        p="${p//./\\.}"
        p="${p//+/\\+}"
        p="${p//^/\\^}"
        p="${p//\$/\\\$}"
        p="${p//(/\\(}"
        p="${p//)/\\)}"
        p="${p//\{/\\\{}"
        p="${p//\}/\\\}}"
        p="${p//|/\\|}"

        # 2. Protect multi-segment globstars using collision-free sentinels
        p="${p//\/\*\*\//__SLASH_GLOBSTAR_SLASH__}"
        # Leading **/
        if [[ "$p" == \*\** ]]; then
            p="${p/#\*\*\//__LEADING_GLOBSTAR_SLASH__}"
        fi
        # Trailing /**
        if [[ "$p" == *\/\*\* ]]; then
            p="${p/%\/\*\*/__SLASH_TRAILING_GLOBSTAR__}"
        fi
        p="${p//\*\*/__GLOBSTAR__}"

        # 3. Translate single-segment wildcard and single-char tokens
        p="${p//\*/[^/]*}"
        p="${p//\?/[^/]}"

        # 4. Expand sentinels into POSIX regex
        p="${p//__SLASH_GLOBSTAR_SLASH__/\/(.*\/)?}"
        p="${p//__LEADING_GLOBSTAR_SLASH__/(.*\/)?}"
        p="${p//__SLASH_TRAILING_GLOBSTAR__/\/(.*)?}"
        p="${p//__GLOBSTAR__/.*}"

        echo "^${p}\$"
    }

    match_pattern_list() {
        local target="$1"
        shift
        local pattern
        for pattern in "$@"; do
            [ -z "$pattern" ] && continue
            # Tier 1 (Exact Match)
            if [ "$target" = "$pattern" ]; then
                return 0
            fi
            # Tier 2 (Directory Prefix Match)
            if [[ "$pattern" == */ ]]; then
                if [[ "$target" == "$pattern"* ]]; then
                    return 0
                fi
            fi
            # Tier 3 (Glob / Regex Match)
            if [[ "$pattern" == *[*?\[]* ]]; then
                local regex
                regex=$(glob_to_regex "$pattern")
                if [[ "$target" =~ $regex ]]; then
                    return 0
                fi
            fi
        done
        return 1
    }

    # Check each staged file
    for STAGED in "${STAGED_FILES[@]}"; do
        # Always permit invariant root documentation and metadata
        if echo "$STAGED" | grep -qE "$ALWAYS_ALLOWED_REGEX"; then
            continue
        fi
        case "$STAGED" in
            .plans/*|.agents/*)
                continue
                ;;
        esac

        FILE_PERMITTED=0
        HAS_ANY_ACTIVE_TARGETS=0
        UNBLOCKED_PLANS=0
        LAST_DENY_REASON=""

        while IFS= read -r PLAN; do
            [ -z "$PLAN" ] && continue

            if grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*(🚫|BLOCKED)' "$PLAN"; then
                continue
            fi
            UNBLOCKED_PLANS=$((UNBLOCKED_PLANS + 1))

            PLAN_TARGETS=()
            PLAN_OOB=()

            while IFS= read -r ITEM; do
                [ -n "$ITEM" ] && PLAN_TARGETS+=("$ITEM")
            done < <(parse_plan_section "$PLAN" '^### 📂 Target Files|^### 🚨 Emergency Hotfix' '^### 🛑 Out of Bounds|^## ')

            while IFS= read -r ITEM; do
                [ -n "$ITEM" ] && PLAN_OOB+=("$ITEM")
            done < <(parse_plan_section "$PLAN" '^### 🛑 Out of Bounds' '^## ')

            if [ ${#PLAN_TARGETS[@]} -gt 0 ]; then
                HAS_ANY_ACTIVE_TARGETS=1
            fi

            # 1. Check if this plan's own OOB explicitly excludes this staged file
            if [ ${#PLAN_OOB[@]} -gt 0 ] && match_pattern_list "$STAGED" "${PLAN_OOB[@]}"; then
                LAST_DENY_REASON="File is explicitly OUT OF BOUNDS in '$PLAN'!"
                continue
            fi

            # 2. Check if this plan allows the staged file
            if [ ${#PLAN_TARGETS[@]} -gt 0 ] && match_pattern_list "$STAGED" "${PLAN_TARGETS[@]}"; then
                FILE_PERMITTED=1
                break
            fi
        done <<< "$ACTIVE_PLANS"

        if [ "$FILE_PERMITTED" -eq 1 ]; then
            continue
        fi

        if [ "$UNBLOCKED_PLANS" -gt 0 ] && [ "$HAS_ANY_ACTIVE_TARGETS" -eq 0 ] && [ -z "$LAST_DENY_REASON" ]; then
            # Only OOB-defined unblocked plans exist, and this file is not in OOB
            continue
        fi

        echo ""
        if [ -n "$LAST_DENY_REASON" ]; then
            echo "❌ [Pre-Commit Blast Radius Violation] File is explicitly OUT OF BOUNDS!"
        else
            echo "❌ [Pre-Commit Blast Radius Violation] Staged file is outside the allowed Target Files!"
        fi
        echo "   Staged file : $STAGED"
        echo "   Active Plan : $ACTIVE_PLANS"
        echo ""
        echo "   👉 To resolve this:"
        echo "      1. Add the file to '### 📂 Target Files' in the active plan."
        echo "      2. Or bypass with 'SKIP_BLAST_RADIUS=1 git commit' if intentional."
        echo ""
        exit 1
    done
fi

# ------------------------------------------------------------------------------
# 2b. FROZEN PLAN IMMUTABILITY & DESIGN-LOCK ENFORCEMENT (#68)
# ------------------------------------------------------------------------------
extract_plan_section() {
    local sec="$1"
    awk -v s="$sec" '
        $0 ~ "^## ([^0-9]*[[:space:]])?" s "\\." { flag=1; print; next }
        $0 ~ "^## ([^0-9]*[[:space:]])?[0-9]+\\." && flag { flag=0 }
        flag { print }
    '
}

for STAGED in "${STAGED_FILES[@]}"; do
    case "$STAGED" in
        .plans/current/*.md|current/*.md)
            case "$(basename "$STAGED")" in
                000-*) continue ;;
            esac
            ;;
        *)
            continue
            ;;
    esac

    # Skip if file was deleted/removed from index (e.g. archiving via /aapp-done)
    if ! git cat-file -e ":$STAGED" 2>/dev/null; then
        continue
    fi

    # Check committed version in HEAD
    HEAD_CONTENT="$(git show "HEAD:$STAGED" 2>/dev/null || true)"
    [ -z "$HEAD_CONTENT" ] && continue

    # Check if HEAD version was frozen / greenlit
    if ! printf '%s\n' "$HEAD_CONTENT" | grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*(🟢|🟠|Ready for Execution|Frozen|In Development)'; then
        continue
    fi

    INDEX_CONTENT="$(git show ":$STAGED" 2>/dev/null || true)"

    HEAD_SEC2="$(printf '%s\n' "$HEAD_CONTENT" | extract_plan_section 2)"
    INDEX_SEC2="$(printf '%s\n' "$INDEX_CONTENT" | extract_plan_section 2)"

    HEAD_SEC4="$(printf '%s\n' "$HEAD_CONTENT" | extract_plan_section 4)"
    INDEX_SEC4="$(printf '%s\n' "$INDEX_CONTENT" | extract_plan_section 4)"

    DESIGN_VIOLATION=""
    if [ "$HEAD_SEC2" != "$INDEX_SEC2" ]; then
        DESIGN_VIOLATION="Section 2 (Technical Blueprint)"
    fi
    if [ "$HEAD_SEC4" != "$INDEX_SEC4" ]; then
        if [ -n "$DESIGN_VIOLATION" ]; then
            DESIGN_VIOLATION="$DESIGN_VIOLATION and Section 4 (Blast Radius & System Boundaries)"
        else
            DESIGN_VIOLATION="Section 4 (Blast Radius & System Boundaries)"
        fi
    fi

    if [ -n "$DESIGN_VIOLATION" ]; then
        echo ""
        echo "❌ [Pre-Commit Design Lock Violation] Cannot edit locked design sections of a frozen plan!"
        echo "   Staged plan : $STAGED"
        echo "   Violation   : Attempted modifications to $DESIGN_VIOLATION"
        echo "   Status      : 🟢 Frozen (Design Locked)"
        echo ""
        echo "   👉 To resolve this:"
        echo "      1. Revert changes to Section 2 and Section 4."
        echo "      2. Or unfreeze the plan by changing status back to '🟡 Refining' before amending the design."
        echo ""
        exit 1
    fi
done

# ------------------------------------------------------------------------------
# 3. DOCUMENTATION REMINDER (NON-BLOCKING WARNING)
# ------------------------------------------------------------------------------
DOCS_UPDATED=0
for F in "${STAGED_FILES[@]}"; do
    if echo "$F" | grep -qE '^(README\.md|MANUAL\.md|CODEMAP\.md|ARCHITECTURE\.md|\.agents/CODEMAP\.md|\.agents/ARCHITECTURE\.md)$'; then
        DOCS_UPDATED=1
        break
    fi
done
if [ "$DOCS_UPDATED" -eq 0 ] && [ -d ".agents" ] && git -C .agents rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C .agents status --porcelain 2>/dev/null | grep -qE '(CODEMAP|ARCHITECTURE)\.md'; then
        DOCS_UPDATED=1
    fi
fi
if [ "$STAGED_CORE_COUNT" -gt 0 ] && [ "$DOCS_UPDATED" -eq 0 ]; then
    echo "⚠️  [Pre-Commit Reminder] Documentation (README.md, ARCHITECTURE.md, or .agents/CODEMAP.md) was not updated."
    echo "   If this commit introduces new interfaces, routes, or behaviors, ensure documentation stays in sync."
fi

# ------------------------------------------------------------------------------
# 3b. ISSUE ROADMAP & LEDGER HYGIENE (AUTO-PRUNE & DETECT-AND-BLOCK)
# ------------------------------------------------------------------------------
ROADMAP_FILE=""
if [ -f "issues_road_map.md" ]; then
    ROADMAP_FILE="issues_road_map.md"
elif [ -f ".plans/issues_road_map.md" ]; then
    ROADMAP_FILE=".plans/issues_road_map.md"
fi

ROADMAP_RESOLVED_REGEX='^[[:space:]]*([0-9]+\.|-[[:space:]]*\[[ xX]?\]|\*)[[:space:]]*`?(#|ISSUE-)?[0-9]+`?.*(✅|[Rr]esolved)'

if [ -n "$ROADMAP_FILE" ] && grep -qE "$ROADMAP_RESOLVED_REGEX" "$ROADMAP_FILE" 2>/dev/null; then
    TMP_ROADMAP="$(mktemp 2>/dev/null || echo "$ROADMAP_FILE.tmp")"
    if grep -v -E "$ROADMAP_RESOLVED_REGEX" "$ROADMAP_FILE" > "$TMP_ROADMAP" 2>/dev/null; then
        mv "$TMP_ROADMAP" "$ROADMAP_FILE"
        if [ "$ROADMAP_FILE" = "issues_road_map.md" ]; then
            git add "$ROADMAP_FILE" 2>/dev/null || true
        fi
        echo "🧹 [Pre-Commit Notice] Auto-pruned resolved issues from $ROADMAP_FILE"
    else
        rm -f "$TMP_ROADMAP"
    fi
fi

# Detect-and-block resolved rows in active ISSUES.md
ISSUES_FILE=""
if [ -f "ISSUES.md" ]; then
    ISSUES_FILE="ISSUES.md"
elif [ -f ".plans/ISSUES.md" ]; then
    ISSUES_FILE=".plans/ISSUES.md"
fi

ISSUES_RESOLVED_ROW_REGEX='^[[:space:]]*\|[[:space:]]*`?(#|ISSUE-)?[0-9]+`?.*(✅|[Rr]esolved)'

if [ -n "$ISSUES_FILE" ] && grep -qE "$ISSUES_RESOLVED_ROW_REGEX" "$ISSUES_FILE" 2>/dev/null; then
    echo ""
    echo "❌ [Pre-Commit Violation] Found resolved issue in active $ISSUES_FILE."
    echo "   The Relocation Invariant requires resolved rows to be moved to .plans/done/000-issues-archive.md."
    echo "   Resolution is a physical row relocation, never an in-place status badge."
    echo ""
    exit 1
fi

# ------------------------------------------------------------------------------
# 4. OPTIONAL SYNTAX & LINTER VALIDATIONS (BLOCKING)
# ------------------------------------------------------------------------------
for FILE in "${STAGED_FILES[@]}"; do
    [ ! -f "$FILE" ] && continue

    # Shell Syntax Check
    if [[ "$FILE" == *.sh || "$FILE" == *.bash ]] && command -v bash >/dev/null 2>&1; then
        if ! bash -n "$FILE" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] Bash Syntax Error in staged file: $FILE"
            bash -n "$FILE" || true
            exit 1
        fi
    fi

    # Python Syntax Check
    if [[ "$FILE" == *.py ]] && command -v python3 >/dev/null 2>&1; then
        if ! python3 -m py_compile "$FILE" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] Python Syntax Error in staged file: $FILE"
            python3 -m py_compile "$FILE" || true
            exit 1
        fi
    fi

    # PHP Syntax Check
    if [[ "$FILE" == *.php ]] && command -v php >/dev/null 2>&1; then
        if ! php -l "$FILE" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] PHP Syntax Error in staged file: $FILE"
            php -l "$FILE"
            exit 1
        fi
    fi

    # JSON Schema Syntax Check
    if [[ "$FILE" =~ ^schema/.*\.json$ ]]; then
        if command -v python3 >/dev/null 2>&1; then
            if ! python3 -c "import json, sys; json.load(open(sys.argv[1], encoding='utf-8'))" "$FILE" >/dev/null 2>&1; then
                echo "❌ [Pre-Commit Error] Invalid JSON syntax in schema file: $FILE"
                exit 1
            fi
        fi
    fi
done

echo "✅ [Git Pre-Commit] Pre-commit checks passed successfully!"
exit 0

#!/usr/bin/env bash
# ==============================================================================
# Asymmetric Agent Planning Protocol (AAPP) - Git Pre-Commit Hook
#
# 1. CHANGELOG.md Enforcement (Blocking for source code changes)
# 2. Deterministic Blast Radius Enforcement (Validates staged files against .plans/current/*.md)
# 3. Documentation Invariant Reminders (Non-blocking warning)
# 4. Extensible Syntax & Linter Validations (PHP, JS/TS, Python, JSON schemas, etc.)
# ==============================================================================
set -e

# ------------------------------------------------------------------------------
# 0. Pre-Flight: Runtime Reachability & Inspection-Only Gate
# ------------------------------------------------------------------------------
AAPP_BIN=""
if command -v aapp >/dev/null 2>&1; then
    AAPP_BIN="$(command -v aapp)"
elif [ -x "$HOME/.local/bin/aapp" ]; then
    AAPP_BIN="$HOME/.local/bin/aapp"
fi

if [ -z "$AAPP_BIN" ]; then
    echo "❌ [AAPP Guard] 'aapp' command not found in PATH or ~/.local/bin." >&2
    echo "" >&2
    echo "   This repository is governed by the Asymmetric Agent Planning Protocol." >&2
    echo "   Without the 'aapp' toolchain installed, this clone is in INSPECTION-ONLY mode." >&2
    echo "   Commits are locked to prevent un-guarded code and plan desynchronization." >&2
    echo "" >&2
    echo "   To enable development and commits, install AAPP globally:" >&2
    echo "     git clone https://github.com/aapp-protocol/aapp-kit.git && ./aapp-kit/aapp install" >&2
    echo "" >&2
    exit 1
fi

# Escape hatch for blast radius & changelog (runs after reachability assertion)
if [ "${SKIP_BLAST_RADIUS:-0}" = "1" ]; then
    echo "⚡ [Pre-Commit Notice] Blast Radius and CHANGELOG verification skipped via SKIP_BLAST_RADIUS=1."
    exit 0
fi

# ------------------------------------------------------------------------------
# 0b. Shared Library (P-37): plan parsing and glob matching, fail-closed
# ------------------------------------------------------------------------------
# Resolved from this hook's own directory; ${0%/*} rather than dirname so the
# load needs no external binary.
case "$0" in
    */*) AAPP_HOOK_DIR="${0%/*}" ;;
    *)   AAPP_HOOK_DIR="." ;;
esac
AAPP_LIB_FILE="$AAPP_HOOK_DIR/aapp-lib.sh"
# shellcheck source=lib/aapp-lib.sh
if ! . "$AAPP_LIB_FILE" 2>/dev/null || ! declare -f aapp_lib_loaded >/dev/null; then
    echo "❌ [AAPP Guard] Shared library missing or unreadable: $AAPP_LIB_FILE" >&2
    echo "   Run 'aapp init' to reinstall the hook engine." >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CURRENT_WT_NAME="$(basename "$REPO_ROOT")"
cd "$REPO_ROOT"

# Staged files list (NUL-safe array) - includes additions, modifications, and deletions
STAGED_FILES=()
while IFS= read -r -d '' FILE; do
    [ -n "$FILE" ] && STAGED_FILES+=("$FILE")
done < <(git diff --cached --name-only -z --diff-filter=ACMRD)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

# ------------------------------------------------------------------------------
# 0. ADAPTIVE BRANCH PROTECTION (STABLE VS. EDGE GUARD)
# ------------------------------------------------------------------------------
if [ "${ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
    PROTECT_STABLE="$(git config --bool aapp.protectStable 2>/dev/null || echo "true")"
    if [ "$PROTECT_STABLE" != "false" ]; then
        CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"
        if [ -n "$CURRENT_BRANCH" ]; then
            PROTECTED_BRANCHES="$(git config aapp.protectedBranches 2>/dev/null || echo "main master production")"
            DEV_BRANCHES="$(git config aapp.devBranch 2>/dev/null || echo "develop dev development")"

            IS_PROTECTED=0
            for PB in $PROTECTED_BRANCHES; do
                if [ "$CURRENT_BRANCH" = "$PB" ]; then
                    IS_PROTECTED=1
                    break
                fi
            done

            if [ "$IS_PROTECTED" -eq 1 ]; then
                # Probe if an active development branch exists (local or remote tracking)
                DEV_BRANCH_FOUND=""
                for DB in $DEV_BRANCHES; do
                    if git show-ref --verify --quiet "refs/heads/$DB" 2>/dev/null || \
                       git show-ref --verify --quiet "refs/remotes/origin/$DB" 2>/dev/null || \
                       git show-ref --quiet -- "refs/remotes/*/$DB" 2>/dev/null; then
                        DEV_BRANCH_FOUND="$DB"
                        break
                    fi
                done

                if [ -n "$DEV_BRANCH_FOUND" ]; then
                    echo ""
                    echo "❌ [AAPP Branch Protection] Direct commits to '$CURRENT_BRANCH' are prohibited!"
                    echo "   A development branch ('$DEV_BRANCH_FOUND') exists for active engineering."
                    echo ""
                    echo "   👉 Switch to your development branch before committing:"
                    echo "      git checkout $DEV_BRANCH_FOUND"
                    echo ""
                    echo "   💡 If this is an intentional release or hotfix commit on '$CURRENT_BRANCH':"
                    echo "      ALLOW_MAIN_COMMIT=1 git commit -m \"...\""
                    echo "   💡 Or to disable branch protection for trunk-based development:"
                    echo "      git config --bool aapp.protectStable false"
                    echo ""
                    exit 1
                fi
            fi
        fi
    fi
fi

# ------------------------------------------------------------------------------
# 0b. PROJECT CIRCUIT BREAKER (EMERGENCY PAUSE CHECK)
# ------------------------------------------------------------------------------
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo ".git")"
if [ -d "$GIT_COMMON_DIR" ]; then
    PRIMARY_ROOT="$(cd "$GIT_COMMON_DIR/.." 2>/dev/null && pwd)"
else
    PRIMARY_ROOT="$REPO_ROOT"
fi

PAUSED_FILE="$GIT_COMMON_DIR/aapp_paused"
SHARED_PAUSED_FILE=""
if [ -d "$REPO_ROOT/.plans" ]; then
    SHARED_PAUSED_FILE="$REPO_ROOT/.plans/PAUSED.md"
elif [ -n "$PRIMARY_ROOT" ] && [ -d "$PRIMARY_ROOT/.plans" ]; then
    SHARED_PAUSED_FILE="$PRIMARY_ROOT/.plans/PAUSED.md"
fi

if [ -f "$PAUSED_FILE" ] || { [ -n "$SHARED_PAUSED_FILE" ] && [ -f "$SHARED_PAUSED_FILE" ]; }; then
    CURRENT_WT_NAME="$(basename "$REPO_ROOT")"
    PAUSE_BLOCKED_TOUCHED=0

    if [ "$CURRENT_WT_NAME" = ".plans" ]; then
        for F in "${STAGED_FILES[@]}"; do
            case "$F" in
                pickup*|ISSUES.md|issues*|current/*)
                    ;;
                *)
                    PAUSE_BLOCKED_TOUCHED=1
                    break
                    ;;
            esac
        done
    else
        for F in "${STAGED_FILES[@]}"; do
            case "$F" in
                .plans/pickup*|.plans/ISSUES.md|.plans/issues*|.plans/current/*)
                    ;;
                *)
                    PAUSE_BLOCKED_TOUCHED=1
                    break
                    ;;
            esac
        done
    fi

    if [ "$PAUSE_BLOCKED_TOUCHED" -eq 1 ]; then
        PAUSE_REASON=""
        if [ -f "$PAUSED_FILE" ]; then
            if command -v python3 >/dev/null 2>&1; then
                PAUSE_REASON=$(python3 -c 'import json, sys; d=json.load(open(sys.argv[1])); print(d.get("reason", ""))' "$PAUSED_FILE" 2>/dev/null || true)
            else
                PAUSE_REASON=$(grep -oE '"reason"[[:space:]]*:[[:space:]]*"[^"]+"' "$PAUSED_FILE" 2>/dev/null | head -n 1 | sed -E 's/.*:[[:space:]]*"([^"]+)".*/\1/' || true)
            fi
        fi
        if [ -z "$PAUSE_REASON" ] && [ -n "$SHARED_PAUSED_FILE" ] && [ -f "$SHARED_PAUSED_FILE" ]; then
            PAUSE_REASON=$(sed -nE 's/^[[:space:]]*\*[[:space:]]*\*\*Reason:\*\*[[:space:]]*(.*)/\1/p' "$SHARED_PAUSED_FILE" 2>/dev/null | head -n 1 || true)
        fi
        [ -z "$PAUSE_REASON" ] && PAUSE_REASON="developer paused project"

        echo ""
        echo "❌ [Project Circuit Breaker] Commits are refused while the project is PAUSED."
        echo "   Reason: $PAUSE_REASON"
        echo "   While paused, only reflections within .plans/ (pickup, issues, current) may be committed."
        echo "   All other commits (codebase, .agents/, templates, hooks) are blocked."
        echo "   To resume commits across the repository, run 'aapp resume'."
        echo ""
        exit 1
    fi
fi

# Shared docs come from aapp-lib.sh (one definition, P-48); dependency manifests
# are always allowed to commit but are not shared docs.
ALWAYS_ALLOWED_REGEX="^($(aapp_shared_docs_regex)|\.gitignore|\.gitattributes|package\.json|package-lock\.json|composer\.json|composer\.lock|go\.mod|go\.sum|Cargo\.toml|Cargo\.lock|pyproject\.toml|requirements\.txt)\$"

CORE_CODE_REGEX='\.(php|js|jsx|ts|tsx|py|go|rs|c|cpp|h|hpp|java|rb|css|scss|sql|html|sh|bash|zsh)$|^schema/.*\.json$|^aapp$'

STAGED_CORE_COUNT=0
if [ "$CURRENT_WT_NAME" != ".plans" ] && [ "$CURRENT_WT_NAME" != ".agents" ]; then
    for F in "${STAGED_FILES[@]}"; do
        if echo "$F" | grep -qE "$CORE_CODE_REGEX"; then
            STAGED_CORE_COUNT=$((STAGED_CORE_COUNT + 1))
        fi
    done
fi

# ------------------------------------------------------------------------------
# 1. CHANGELOG.md ENFORCEMENT (BLOCKING FOR CORE CODE)
# ------------------------------------------------------------------------------
if [ "$STAGED_CORE_COUNT" -gt 0 ]; then
    CHANGELOG_UPDATED=0
    # Check if root CHANGELOG.md or .plans/CHANGELOG.md is staged in this commit
    for F in "${STAGED_FILES[@]}"; do
        if [ "$F" = "CHANGELOG.md" ] || [ "$F" = ".plans/CHANGELOG.md" ]; then
            CHANGELOG_UPDATED=1
            break
        fi
    done

    # If not staged in current git index, check if .plans/CHANGELOG.md exists in worktree and was updated
    if [ "$CHANGELOG_UPDATED" -eq 0 ] && [ -d ".plans" ]; then
        if git -C .plans rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            if git -C .plans status --porcelain 2>/dev/null | grep -qE 'CHANGELOG\.md'; then
                CHANGELOG_UPDATED=1
            elif git -C .plans log -1 --name-only --format="" 2>/dev/null | grep -qE '^CHANGELOG\.md$'; then
                CHANGELOG_UPDATED=1
            fi
        fi
    fi

    # P-48: in `plan` mode (default) a commit for an active plan also passes when
    # the staged CHANGELOG.md already carries that plan's entry. `commit` mode and
    # commits with no active plan keep the rule above: the file must change.
    CL_PLAN_ID=""
    if [ "$CHANGELOG_UPDATED" -eq 0 ]; then
        CL_MODE="$(git config --get aapp.changelogMode 2>/dev/null)" || CL_MODE="plan"
        if [ "$CL_MODE" = "plan" ]; then
            CL_PLANS=""
            if [ -d "$REPO_ROOT/.plans/current" ]; then
                CL_PLANS="$REPO_ROOT/.plans"
            else
                CL_COMMON="$(git rev-parse --git-common-dir 2>/dev/null)" && \
                    [ -d "$CL_COMMON/../.plans/current" ] && CL_PLANS="$(cd "$CL_COMMON/.." && pwd)/.plans"
            fi
            CL_PLAN_FILE=""
            if [ -n "$CL_PLANS" ]; then
                CL_BUF="$(git rev-parse --git-path aapp_active_plan 2>/dev/null)"
                CL_WANT=""
                [ -f "$CL_BUF" ] && CL_WANT="$(head -n 1 "$CL_BUF" | tr -d '[:space:]')"
                CL_DEV=()
                CL_HELD=""
                [ -z "$CL_WANT" ] && CL_HELD="$(aapp_held_plans)"
                for pf in "$CL_PLANS"/current/*.md; do
                    [ -f "$pf" ] || continue
                    case "$(basename "$pf")" in 000-*) continue ;; esac
                    pid="$(sed -nE 's/^[[:space:]]*\*[[:space:]]*\*\*Plan ID:\*\*[[:space:]]*([^[:space:]]+).*/\1/p' "$pf" | head -n 1)"
                    if [ -n "$CL_WANT" ]; then
                        [ "$pid" = "$CL_WANT" ] && CL_DEV=("$pf") && break
                    elif grep -qE '^[[:space:]]*\*[[:space:]]*\*\*Status:\*\*.*⚡[[:space:]]*In Development' "$pf"; then
                        aapp_plan_held_by "$pf" "$CL_HELD" >/dev/null && continue
                        CL_DEV+=("$pf")
                    fi
                done
                [ ${#CL_DEV[@]} -eq 1 ] && CL_PLAN_FILE="${CL_DEV[0]}"
            fi
            if [ -n "$CL_PLAN_FILE" ]; then
                CL_PLAN_ID="$(sed -nE 's/^[[:space:]]*\*[[:space:]]*\*\*Plan ID:\*\*[[:space:]]*([^[:space:]]+).*/\1/p' "$CL_PLAN_FILE" | head -n 1)"
                if [ -n "$CL_PLAN_ID" ] && git show :CHANGELOG.md 2>/dev/null | aapp_changelog_plan_line "$CL_PLAN_ID" >/dev/null; then
                    CHANGELOG_UPDATED=1
                fi
            fi
        fi
    fi

    if [ "$CHANGELOG_UPDATED" -eq 0 ]; then
        echo ""
        echo "❌ [Pre-Commit Error] Core code files were modified, but CHANGELOG.md was not updated!"
        if [ -n "$CL_PLAN_ID" ]; then
            echo "   👉 Plan $CL_PLAN_ID has no entry under ## [Unreleased] yet. Commit with 'aapp commit',"
            echo "      which writes the plan's declared **Changelog:** entry, or declare it with 'aapp refine'."
        else
            echo "   👉 Please document your changes in CHANGELOG.md (or .plans/CHANGELOG.md) and stage it:"
            echo "      git add CHANGELOG.md"
        fi
        echo ""
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# 1a. CHANGELOG.md CONCISENESS & SINGLE-LINE BULLET INVARIANT
# ------------------------------------------------------------------------------
# Enforces that every newly added entry in CHANGELOG.md is a single-line bullet
# starting with '- ' (or '* ') and does not exceed aapp.changelogMaxLen (default 300 chars).
# Multi-line indented paragraphs or unbulleted continuation lines are strictly blocked.
MAX_CHANGELOG_LEN="$(git config --int aapp.changelogMaxLen 2>/dev/null || echo "300")"
for CL_FILE in "CHANGELOG.md" ".plans/CHANGELOG.md"; do
    CL_DIFF=""
    if [ "$CL_FILE" = "CHANGELOG.md" ]; then
        if git diff --cached --name-only 2>/dev/null | grep -qxF "CHANGELOG.md"; then
            CL_DIFF="$(git diff --cached -U0 "CHANGELOG.md" 2>/dev/null | grep '^+[^+]' || true)"
        fi
    elif [ "$CL_FILE" = ".plans/CHANGELOG.md" ]; then
        if git diff --cached --name-only 2>/dev/null | grep -qxF ".plans/CHANGELOG.md"; then
            CL_DIFF="$(git diff --cached -U0 ".plans/CHANGELOG.md" 2>/dev/null | grep '^+[^+]' || true)"
        elif [ -d ".plans" ] && git -C .plans rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            CL_DIFF="$(git -C .plans diff --cached -U0 "CHANGELOG.md" 2>/dev/null | grep '^+[^+]' || true)"
            if [ -z "$CL_DIFF" ]; then
                CL_DIFF="$(git -C .plans diff -U0 "CHANGELOG.md" 2>/dev/null | grep '^+[^+]' || true)"
            fi
        fi
    fi

    if [ -n "$CL_DIFF" ]; then
        while IFS= read -r raw_line; do
            line="${raw_line#+}"
            # Skip empty or whitespace-only lines
            [[ -z "${line// }" ]] && continue
            # Skip Markdown headers, HTML comments, horizontal rules, footer links, and standard preamble
            case "$line" in
                '#'*) continue ;;
                '<!--'*|[[:space:]]*'<!--'*) continue ;;
                '---'*|'___'*|'***'*) continue ;;
                '['*']:'*|[[:space:]]*'['*']:'*) continue ;;
                'All notable changes'*|*'Keep a Changelog'*|*'Semantic Versioning'*) continue ;;
            esac

            # Rule 1: Shape Invariant - Must be a single-line bullet starting with - or *
            if [[ ! "$line" =~ ^[[:space:]]*[-*][[:space:]]+ ]]; then
                echo ""
                echo "❌ [Pre-Commit Error] Changelog entry has unbulleted continuation line!"
                echo "   File: $CL_FILE"
                echo "   Line: $line"
                echo ""
                echo "   👉 Changelog entries must be concise, single-line bullets starting with '- '."
                echo "   👉 Multi-line paragraphs or unbulleted continuation lines are prohibited."
                echo ""
                exit 1
            fi

            # Rule 2: Bullet Length Ceiling
            LINE_LEN="${#line}"
            if [ "$LINE_LEN" -gt "$MAX_CHANGELOG_LEN" ]; then
                echo ""
                echo "❌ [Pre-Commit Error] Changelog bullet exceeds maximum length ($LINE_LEN > $MAX_CHANGELOG_LEN chars)!"
                echo "   File: $CL_FILE"
                echo "   Line: $line"
                echo ""
                echo "   👉 Keep a Changelog requires concise, single-line bullet points (<= $MAX_CHANGELOG_LEN chars)."
                echo "   👉 Move technical blueprints, file lists, and internal implementation mechanics to .plans/ blueprints."
                echo ""
                exit 1
            fi
        done <<< "$CL_DIFF"
    fi
done

# ------------------------------------------------------------------------------
# 1b. PORTABILITY & MACHINE-AGNOSTIC PATH ENFORCEMENT
# ------------------------------------------------------------------------------
# Blocks machine-specific file:/// URIs and absolute local paths in repository files.
# Preserves test suites where mock URIs and error fixtures may be legitimately exercised.
URI_VIOLATIONS=0
URI_PATTERN='(\]\(file:///|<file:///|file:///(home|Users|root|tmp|var|etc|opt|usr|srv|[a-zA-Z]:)|\]\((/home/|/Users/|/root/|[a-zA-Z]:[/\\]))'

for F in "${STAGED_FILES[@]}"; do
    [ -f "$F" ] || continue
    case "$F" in
        tests/*|test/*|*_test.*|*.test.*|*test_*|spec/*|*/tests/*|*pre-commit*|*.githooks/*)
            continue
            ;;
    esac

    MATCHES=$(git show ":$F" 2>/dev/null | grep -nE "$URI_PATTERN" || true)
    if [ -n "$MATCHES" ]; then
        if [ "$URI_VIOLATIONS" -eq 0 ]; then
            echo ""
            echo "❌ [Pre-Commit Error] Machine-specific absolute path or 'file://' URI detected in staged files!"
            echo "   Repository files must use relative paths to preserve portability and prevent local path leaks."
            echo ""
        fi
        URI_VIOLATIONS=$((URI_VIOLATIONS + 1))
        echo "   📄 $F:"
        echo "$MATCHES" | head -n 5 | while IFS= read -r line; do
            echo "      line $line"
        done
        echo ""
    fi
done

if [ "$URI_VIOLATIONS" -gt 0 ]; then
    echo "   👉 Replace absolute paths and 'file:///' URIs with relative paths (e.g. 'README.md' or '../doc.md')."
    echo "   💡 Note: IDE system prompt rules requiring 'file://' links apply only to conversational chat,"
    echo "      never to committed files."
    echo ""
    exit 1
fi

# ------------------------------------------------------------------------------
# 2. DETERMINISTIC BLAST RADIUS ENFORCEMENT (BLOCKING WHEN ACTIVE PLANS EXIST)
# ------------------------------------------------------------------------------
# 2. Canonical Worktree & .plans/ Resolution
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo ".git")"
if [ -d "$GIT_COMMON_DIR" ]; then
    PRIMARY_ROOT="$(cd "$GIT_COMMON_DIR/.." 2>/dev/null && pwd)"
else
    PRIMARY_ROOT="$REPO_ROOT"
fi

if [ -d "$REPO_ROOT/.plans" ]; then
    PLANS_DIR="$REPO_ROOT/.plans"
elif [ -n "$PRIMARY_ROOT" ] && [ -d "$PRIMARY_ROOT/.plans" ]; then
    PLANS_DIR="$PRIMARY_ROOT/.plans"
else
    PLANS_DIR=""
fi

# Check if any non-bypassed files are staged
NON_BYPASS_COUNT=0
for STAGED in "${STAGED_FILES[@]}"; do
    if echo "$STAGED" | grep -qE "$ALWAYS_ALLOWED_REGEX"; then
        continue
    fi
    case "$STAGED" in
        .plans/*|.agents/*)
            continue
            ;;
    esac
    if [ "$CURRENT_WT_NAME" = ".plans" ] || [ "$CURRENT_WT_NAME" = ".agents" ]; then
        continue
    fi
    NON_BYPASS_COUNT=$((NON_BYPASS_COUNT + 1))
done

if [ "$NON_BYPASS_COUNT" -gt 0 ]; then
    # 2b. Fail-Closed Quarantine in AAPP Repositories
    if [ -z "$PLANS_DIR" ] || [ ! -d "$PLANS_DIR/current" ]; then
        if [ -f "$REPO_ROOT/.githooks/aapp-pre-commit" ] || [ -f "$PRIMARY_ROOT/.githooks/aapp-pre-commit" ] || \
           [ -f "$REPO_ROOT/aapp" ] || [ -f "$PRIMARY_ROOT/aapp" ]; then
            echo ""
            echo "❌ [Pre-Commit Blast Radius Violation] AAPP repository detected but .plans/current directory is missing or unmounted."
            echo "   Commit is blocked by fail-closed isolation quarantine."
            echo ""
            exit 1
        fi
    fi

    # Check if any BLOCKED plan exists and staged files match its targets. A
    # bound mini plan (P-52) may commit its own files even when a BLOCKED plan
    # lists them: the rule stops the blocked plan, not its sanctioned fix.
    if [ -n "$PLANS_DIR" ] && [ -d "$PLANS_DIR/current" ]; then
        MINI_TARGETS=()
        MINI_BUF="$(git rev-parse --git-path aapp_active_plan 2>/dev/null || true)"
        MINI_ID="$(head -n 1 "$MINI_BUF" 2>/dev/null | tr -d '[:space:]' || true)"
        case "$MINI_ID" in
            '#'*) [ -f "$PLANS_DIR/current/fix-${MINI_ID#\#}.md" ] && while IFS= read -r ITEM; do
                      [ -n "$ITEM" ] && MINI_TARGETS+=("$ITEM")
                  done < <(parse_plan_target_paths "$PLANS_DIR/current/fix-${MINI_ID#\#}.md") ;;
        esac
        for pf in "$PLANS_DIR"/current/*.md; do
            [ ! -f "$pf" ] && continue
            case "$(basename "$pf")" in 000-*) continue ;; esac
            if grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*(🚫|🟥|BLOCKED)' "$pf" 2>/dev/null; then
                BLOCKED_TARGETS=()
                while IFS= read -r ITEM; do
                    [ -n "$ITEM" ] && BLOCKED_TARGETS+=("$ITEM")
                done < <(parse_plan_target_paths "$pf")
                if [ ${#BLOCKED_TARGETS[@]} -gt 0 ]; then
                    for STAGED in "${STAGED_FILES[@]}"; do
                        if echo "$STAGED" | grep -qE "$ALWAYS_ALLOWED_REGEX"; then
                            continue
                        fi
                        case "$STAGED" in
                            .plans/*|.agents/*)
                                continue
                                ;;
                        esac
                        if [ "$CURRENT_WT_NAME" = ".plans" ] || [ "$CURRENT_WT_NAME" = ".agents" ]; then
                            continue
                        fi
                        if [ ${#MINI_TARGETS[@]} -gt 0 ] && match_pattern_list "$STAGED" "${MINI_TARGETS[@]}"; then
                            continue
                        fi
                        if match_pattern_list "$STAGED" "${BLOCKED_TARGETS[@]}"; then
                            echo ""
                            echo "❌ [Pre-Commit Blast Radius Violation] Plan '$(basename "$pf")' is BLOCKED! Staged file '$STAGED' belongs to a blocked plan."
                            echo "   All commits against a BLOCKED plan are refused."
                            echo ""
                            exit 1
                        fi
                    done
                fi
            fi
        done
    fi

    # 3. Active Plan Context Resolution (Pointer Buffer -> Single 🟠 Auto-Discovery)
    ACTIVE_PLAN_FILE="$(git rev-parse --git-path aapp_active_plan 2>/dev/null || echo ".git/aapp_active_plan")"
    DESIGNATED_PLAN_ID=""
    if [ -f "$ACTIVE_PLAN_FILE" ]; then
        DESIGNATED_PLAN_ID="$(head -n 1 "$ACTIVE_PLAN_FILE" 2>/dev/null | tr -d '[:space:]')"
    fi

    ACTIVE_PLAN_PATH=""
    if [ -n "$PLANS_DIR" ] && [ -d "$PLANS_DIR/current" ]; then
        if [ -n "$DESIGNATED_PLAN_ID" ]; then
            for pf in "$PLANS_DIR"/current/*.md; do
                [ ! -f "$pf" ] && continue
                case "$(basename "$pf")" in 000-*) continue ;; esac
                plan_id="$(sed -nE 's/^[[:space:]]*\*[[:space:]]*\*\*Plan ID:\*\*[[:space:]]*([^[:space:]]+).*/\1/p' "$pf" 2>/dev/null || true)"
                bname="$(basename "$pf" .md)"
                if [ "$plan_id" = "$DESIGNATED_PLAN_ID" ] || [ "$bname" = "$DESIGNATED_PLAN_ID" ] || \
                   [[ "$bname" == "$DESIGNATED_PLAN_ID-"* ]] || [[ "$bname" == "P$DESIGNATED_PLAN_ID-"* ]] || \
                   [[ "$bname" == "P-$DESIGNATED_PLAN_ID-"* ]]; then
                    ACTIVE_PLAN_PATH="$pf"
                    break
                fi
            done
            if [ -z "$ACTIVE_PLAN_PATH" ]; then
                echo ""
                echo "❌ [Pre-Commit Blast Radius Violation] Designated active plan '$DESIGNATED_PLAN_ID' not found in $PLANS_DIR/current/."
                echo "   Run 'aapp plan-clear' or 'aapp plan <id>' to resolve."
                echo ""
                exit 1
            fi
        else
            # P-52: plans held by another worktree's buffer are not adopted
            # here, and their files are refused in this unbound checkout.
            HELD_PLANS="$(aapp_held_plans)"
            DEV_PLANS=()
            for pf in "$PLANS_DIR"/current/*.md; do
                [ ! -f "$pf" ] && continue
                case "$(basename "$pf")" in 000-*) continue ;; esac
                if grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*⚡[[:space:]]*In Development' "$pf" 2>/dev/null || \
                   ! grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*' "$pf" 2>/dev/null; then
                    if HOLDER="$(aapp_plan_held_by "$pf" "$HELD_PLANS")"; then
                        HELD_TARGETS=()
                        while IFS= read -r ITEM; do
                            [ -n "$ITEM" ] && HELD_TARGETS+=("$ITEM")
                        done < <(parse_plan_target_paths "$pf")
                        if [ ${#HELD_TARGETS[@]} -gt 0 ]; then
                            for STAGED in "${STAGED_FILES[@]}"; do
                                aapp_is_shared_doc "$STAGED" && continue
                                if match_pattern_list "$STAGED" "${HELD_TARGETS[@]}"; then
                                    echo ""
                                    echo "❌ [Pre-Commit Blast Radius Violation] Staged file '$STAGED' belongs to $(basename "$pf" .md) (in $HOLDER)."
                                    echo "   Commit it from that worktree, or make the fix inside that plan."
                                    echo ""
                                    exit 1
                                fi
                            done
                        fi
                        continue
                    fi
                    DEV_PLANS+=("$pf")
                fi
            done

            if [ ${#DEV_PLANS[@]} -eq 1 ]; then
                ACTIVE_PLAN_PATH="${DEV_PLANS[0]}"
            elif [ ${#DEV_PLANS[@]} -gt 1 ]; then
                PLAN_LIST=$(for p in "${DEV_PLANS[@]}"; do basename "$p" .md; done | tr '\n' ',' | sed 's/,$//')
                echo ""
                echo "❌ [Pre-Commit Blast Radius Violation] Multiple plans are currently in development [$PLAN_LIST]!"
                echo "   Run 'aapp plan <id>' to designate the active commit context."
                echo ""
                exit 1
            fi
            # No plan in development: commits are allowed (#98, P-52 Q1); a
            # frozen plan is backlog and restricts nothing.
        fi
    fi

    # 4. Enforce Blast Radius for Active Plan
    if [ -n "$ACTIVE_PLAN_PATH" ]; then
        if grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*(🚫|🟥|BLOCKED)' "$ACTIVE_PLAN_PATH"; then
            echo ""
            echo "❌ [Pre-Commit Blast Radius Violation] Active plan '$(basename "$ACTIVE_PLAN_PATH")' is BLOCKED!"
            echo "   All commits are refused while a plan is marked 🚫 BLOCKED."
            echo ""
            exit 1
        fi

        # Opt-in failure test declaration check (P-35)
        if plan_has_required_test_files "$ACTIVE_PLAN_PATH"; then
            ACTIVE_STATUS="$(grep -m 1 -E '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*' "$ACTIVE_PLAN_PATH" | sed -E 's/^.*\*\*Status:\*\*[[:space:]]*//')"
            # Enforce only when plan is frozen or in development (tolerated while refining / under review)
            if echo "$ACTIVE_STATUS" | grep -qE '(🔷[[:space:]]*Frozen|⚡[[:space:]]*In Development)'; then
                validate_plan_tdd_correspondence "$ACTIVE_PLAN_PATH" "Pre-Commit TDD" || exit 1

                # At ⚡ In Development, enforce test file existence on disk
                if echo "$ACTIVE_STATUS" | grep -qE '(⚡|[Ii]n [Dd]evelopment)'; then
                    while IFS= read -r f_path; do
                        [ -z "$f_path" ] && continue
                        if [ ! -f "$REPO_ROOT/$f_path" ] && [ ! -f "$PRIMARY_ROOT/$f_path" ] && [ ! -f "$f_path" ]; then
                            echo ""
                            echo "❌ [Pre-Commit TDD Violation] Required test file '$f_path' is missing from disk!"
                            echo "   Active plan : $(basename "$ACTIVE_PLAN_PATH")"
                            echo "   Status      : ⚡ In Development"
                            echo ""
                            exit 1
                        fi
                    done < <(parse_plan_required_test_files "$ACTIVE_PLAN_PATH")
                fi
            fi
        fi

        PLAN_TARGETS=()
        PLAN_OOB=()

        while IFS= read -r ITEM; do
            [ -n "$ITEM" ] && PLAN_TARGETS+=("$ITEM")
        done < <(parse_plan_target_paths "$ACTIVE_PLAN_PATH")

        while IFS= read -r ITEM; do
            [ -n "$ITEM" ] && PLAN_OOB+=("$ITEM")
        done < <(parse_plan_oob_paths "$ACTIVE_PLAN_PATH")

        for STAGED in "${STAGED_FILES[@]}"; do
            if echo "$STAGED" | grep -qE "$ALWAYS_ALLOWED_REGEX"; then
                continue
            fi
            case "$STAGED" in
                .plans/*|.agents/*)
                    continue
                    ;;
            esac
            if [ "$CURRENT_WT_NAME" = ".plans" ] || [ "$CURRENT_WT_NAME" = ".agents" ]; then
                continue
            fi

            # 1. Out of Bounds veto
            if [ ${#PLAN_OOB[@]} -gt 0 ] && match_pattern_list "$STAGED" "${PLAN_OOB[@]}"; then
                echo ""
                echo "❌ [Pre-Commit Blast Radius Violation] File is explicitly OUT OF BOUNDS in active plan '$(basename "$ACTIVE_PLAN_PATH")'!"
                echo "   Staged file : $STAGED"
                echo "   Active Plan : $(basename "$ACTIVE_PLAN_PATH")"
                echo ""
                exit 1
            fi

            # 2. Target Files allow
            if [ ${#PLAN_TARGETS[@]} -gt 0 ] && match_pattern_list "$STAGED" "${PLAN_TARGETS[@]}"; then
                continue
            fi

            # 3. Out-of-bounds only plan
            if [ ${#PLAN_TARGETS[@]} -eq 0 ] && [ ${#PLAN_OOB[@]} -gt 0 ]; then
                continue
            fi

            echo ""
            echo "❌ [Pre-Commit Blast Radius Violation] Staged file is outside the allowed Target Files of active plan '$(basename "$ACTIVE_PLAN_PATH")'!"
            echo "   Staged file : $STAGED"
            echo "   Active Plan : $(basename "$ACTIVE_PLAN_PATH")"
            echo ""
            echo "   👉 To resolve this:"
            echo "      1. Add the file to '### 📂 Target Files' in the active plan."
            echo "      2. Or bypass with 'SKIP_BLAST_RADIUS=1 git commit' if intentional."
            echo ""
            exit 1
        done
    fi
fi

# ------------------------------------------------------------------------------
# 2b. FROZEN PLAN IMMUTABILITY & DESIGN-LOCK ENFORCEMENT (#68)
# ------------------------------------------------------------------------------
for STAGED in "${STAGED_FILES[@]}"; do
    case "$STAGED" in
        .plans/current/*.md|current/*.md)
            case "$(basename "$STAGED")" in
                # P-52: a mini plan's file list is the fixer's, for one
                # temporary fix; `aapp issue fix <num> file` extends it.
                000-*|fix-*) continue ;;
            esac
            ;;
        *)
            continue
            ;;
    esac

    # Skip if file was deleted/removed from index (e.g. archiving via /aapp-done)
    if ! git cat-file -e ":$STAGED" 2>/dev/null; then
        continue
    fi

    # Check committed version in HEAD
    HEAD_CONTENT="$(git show "HEAD:$STAGED" 2>/dev/null || true)"
    [ -z "$HEAD_CONTENT" ] && continue

    # Check if HEAD version was frozen / greenlit
    if ! printf '%s\n' "$HEAD_CONTENT" | grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*(🔷[[:space:]]*Frozen|⚡[[:space:]]*In Development)'; then
        continue
    fi

    INDEX_CONTENT="$(git show ":$STAGED" 2>/dev/null || true)"

    HEAD_SEC2="$(printf '%s\n' "$HEAD_CONTENT" | extract_plan_section 2)"
    INDEX_SEC2="$(printf '%s\n' "$INDEX_CONTENT" | extract_plan_section 2)"

    HEAD_SEC4="$(printf '%s\n' "$HEAD_CONTENT" | extract_plan_section 4)"
    INDEX_SEC4="$(printf '%s\n' "$INDEX_CONTENT" | extract_plan_section 4)"

    DESIGN_VIOLATION=""
    if [ "$HEAD_SEC2" != "$INDEX_SEC2" ]; then
        DESIGN_VIOLATION="Section 2 (Technical Blueprint)"
    fi
    if [ "$HEAD_SEC4" != "$INDEX_SEC4" ]; then
        if [ -n "$DESIGN_VIOLATION" ]; then
            DESIGN_VIOLATION="$DESIGN_VIOLATION and Section 4 (Blast Radius & System Boundaries)"
        else
            DESIGN_VIOLATION="Section 4 (Blast Radius & System Boundaries)"
        fi
    fi

    if [ -n "$DESIGN_VIOLATION" ]; then
        echo ""
        echo "❌ [Pre-Commit Design Lock Violation] Cannot edit locked design sections of a frozen plan!"
        echo "   Staged plan : $STAGED"
        echo "   Violation   : Attempted modifications to $DESIGN_VIOLATION"
        echo "   Status      : 🔷 Frozen (Design Locked)"
        echo ""
        echo "   👉 To resolve this:"
        echo "      1. Revert changes to Section 2 and Section 4."
        echo "      2. Or unfreeze the plan by changing status back to '📝 Refining' before amending the design."
        echo ""
        exit 1
    fi
done

# ------------------------------------------------------------------------------
# 3. DOCUMENTATION REMINDER (NON-BLOCKING WARNING)
# ------------------------------------------------------------------------------
DOCS_UPDATED=0
for F in "${STAGED_FILES[@]}"; do
    if echo "$F" | grep -qE '^(README\.md|MANUAL\.md|CODEMAP\.md|ARCHITECTURE\.md|\.agents/CODEMAP\.md|\.agents/ARCHITECTURE\.md)$'; then
        DOCS_UPDATED=1
        break
    fi
done
if [ "$DOCS_UPDATED" -eq 0 ] && [ -d ".agents" ] && git -C .agents rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C .agents status --porcelain 2>/dev/null | grep -qE '(CODEMAP|ARCHITECTURE)\.md'; then
        DOCS_UPDATED=1
    fi
fi
if [ "$STAGED_CORE_COUNT" -gt 0 ] && [ "$DOCS_UPDATED" -eq 0 ]; then
    echo "⚠️  [Pre-Commit Reminder] Documentation (README.md, ARCHITECTURE.md, or .agents/CODEMAP.md) was not updated."
    echo "   If this commit introduces new interfaces, routes, or behaviors, ensure documentation stays in sync."
fi

# ------------------------------------------------------------------------------
# 3b. ISSUE ROADMAP & LEDGER HYGIENE (AUTO-PRUNE & DETECT-AND-BLOCK)
# ------------------------------------------------------------------------------
ROADMAP_FILE=""
if [ -f "issues_road_map.md" ]; then
    ROADMAP_FILE="issues_road_map.md"
elif [ -f ".plans/issues_road_map.md" ]; then
    ROADMAP_FILE=".plans/issues_road_map.md"
fi

ROADMAP_RESOLVED_REGEX='^[[:space:]]*([0-9]+\.|-[[:space:]]*\[[ xX]?\]|\*)[[:space:]]*`?(#|ISSUE-)?[0-9]+`?.*(✅|[Rr]esolved)'

if [ -n "$ROADMAP_FILE" ] && grep -qE "$ROADMAP_RESOLVED_REGEX" "$ROADMAP_FILE" 2>/dev/null; then
    TMP_ROADMAP="$(mktemp 2>/dev/null || echo "$ROADMAP_FILE.tmp")"
    if grep -v -E "$ROADMAP_RESOLVED_REGEX" "$ROADMAP_FILE" > "$TMP_ROADMAP" 2>/dev/null; then
        mv "$TMP_ROADMAP" "$ROADMAP_FILE"
        if [ "$ROADMAP_FILE" = "issues_road_map.md" ]; then
            git add "$ROADMAP_FILE" 2>/dev/null || true
        fi
        echo "🧹 [Pre-Commit Notice] Auto-pruned resolved issues from $ROADMAP_FILE"
    else
        rm -f "$TMP_ROADMAP"
    fi
fi

# Detect-and-block resolved rows in active ISSUES.md
ISSUES_FILE=""
if [ -f "ISSUES.md" ]; then
    ISSUES_FILE="ISSUES.md"
elif [ -f ".plans/ISSUES.md" ]; then
    ISSUES_FILE=".plans/ISSUES.md"
fi

ISSUES_RESOLVED_ROW_REGEX='^[[:space:]]*\|[[:space:]]*`?(#|ISSUE-)?[0-9]+`?.*(✅|[Rr]esolved)'

if [ -n "$ISSUES_FILE" ] && grep -qE "$ISSUES_RESOLVED_ROW_REGEX" "$ISSUES_FILE" 2>/dev/null; then
    echo ""
    echo "❌ [Pre-Commit Violation] Found resolved issue in active $ISSUES_FILE."
    echo "   The Relocation Invariant requires resolved rows to be moved to .plans/done/000-issues-archive.md."
    echo "   Resolution is a physical row relocation, never an in-place status badge."
    echo ""
    exit 1
fi

# ------------------------------------------------------------------------------
# 3c. PLAN-BOUND COMMIT HELPER REMINDER (P-39)
# ------------------------------------------------------------------------------
# P-51: in atomic commit mode a plan is one commit. A raw code commit for a
# plan that already records a commit is refused; `aapp commit amend` folds
# changes in (helper commits skip this: the helper already decided).
if [ -z "${AAPP_COMMIT_HELPER:-}" ] && [ -n "${ACTIVE_PLAN_PATH:-}" ] && [ -f "$ACTIVE_PLAN_PATH" ] && \
   [ "$(aapp_commit_mode)" = "atomic" ] && \
   grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*⚡[[:space:]]*In Development' "$ACTIVE_PLAN_PATH"; then
    ATOMIC_FIRST="$(parse_plan_commits "$ACTIVE_PLAN_PATH" | head -n 1 | awk '{print $1}')"
    if [ -n "$ATOMIC_FIRST" ]; then
        for STAGED in "${STAGED_FILES[@]}"; do
            echo "$STAGED" | grep -qE "$ALWAYS_ALLOWED_REGEX" && continue
            case "$STAGED" in .plans/*|.agents/*) continue ;; esac
            ATOMIC_ID="$(sed -nE 's/^[[:space:]]*\*[[:space:]]*\*\*Plan ID:\*\*[[:space:]]*([^[:space:]]+).*/\1/p' "$ACTIVE_PLAN_PATH" 2>/dev/null || true)"
            echo ""
            echo "❌ [Pre-Commit Commit Mode] aapp.commitMode=atomic: ${ATOMIC_ID:-the active plan} already has commit $ATOMIC_FIRST."
            echo "   Fold changes in with 'aapp commit amend', or set aapp.commitMode=microcommits."
            echo ""
            exit 1
        done
    fi
fi

if [ -z "${AAPP_COMMIT_HELPER:-}" ] && [ -n "${ACTIVE_PLAN_PATH:-}" ] && [ -f "$ACTIVE_PLAN_PATH" ]; then
    if grep -qE '^[[:space:]]*[\*|-]*[[:space:]]*\*\*Status:\*\*[[:space:]]*.*⚡[[:space:]]*In Development' "$ACTIVE_PLAN_PATH"; then
        ACTIVE_PLAN_ID="$(sed -nE 's/^[[:space:]]*\*[[:space:]]*\*\*Plan ID:\*\*[[:space:]]*([^[:space:]]+).*/\1/p' "$ACTIVE_PLAN_PATH" 2>/dev/null || true)"
        [ -z "$ACTIVE_PLAN_ID" ] && ACTIVE_PLAN_ID="$(basename "$ACTIVE_PLAN_PATH" .md | cut -d'-' -f1)"
        echo "💡 $ACTIVE_PLAN_ID is active: record this commit with 'aapp commit adopt <sha>' (or commit through 'aapp commit')."
    fi
fi

# ------------------------------------------------------------------------------
# 4. OPTIONAL SYNTAX & LINTER VALIDATIONS (BLOCKING)
# ------------------------------------------------------------------------------
for FILE in "${STAGED_FILES[@]}"; do
    [ ! -f "$FILE" ] && continue

    # Shell Syntax Check
    if [[ "$FILE" == *.sh || "$FILE" == *.bash ]] && command -v bash >/dev/null 2>&1; then
        if ! bash -n "$FILE" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] Bash Syntax Error in staged file: $FILE"
            bash -n "$FILE" || true
            exit 1
        fi
    fi

    # Python Syntax Check
    if [[ "$FILE" == *.py ]] && command -v python3 >/dev/null 2>&1; then
        if ! python3 -c "import sys; compile(open(sys.argv[1], 'rb').read(), sys.argv[1], 'exec')" "$FILE" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] Python Syntax Error in staged file: $FILE"
            python3 -c "import sys; compile(open(sys.argv[1], 'rb').read(), sys.argv[1], 'exec')" "$FILE" || true
            exit 1
        fi
    fi

    # PHP Syntax Check
    if [[ "$FILE" == *.php ]] && command -v php >/dev/null 2>&1; then
        if ! php -l "$FILE" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] PHP Syntax Error in staged file: $FILE"
            php -l "$FILE"
            exit 1
        fi
    fi

    # JSON Schema Syntax Check
    if [[ "$FILE" =~ ^schema/.*\.json$ ]]; then
        if command -v python3 >/dev/null 2>&1; then
            if ! python3 -c "import json, sys; json.load(open(sys.argv[1], encoding='utf-8'))" "$FILE" >/dev/null 2>&1; then
                echo "❌ [Pre-Commit Error] Invalid JSON syntax in schema file: $FILE"
                exit 1
            fi
        fi
    fi
done

echo "✅ [Git Pre-Commit] Pre-commit checks passed successfully!"
exit 0

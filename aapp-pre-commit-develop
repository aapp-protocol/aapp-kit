#!/usr/bin/env bash
# ==============================================================================
# AAPP Develop-Only Pre-Commit Engine (P-34)
#
# Kit-authoring invariant: every daily verb in lib/verbs.tsv has a behaviour
# contract in lib/docs/verbs/, every contract has exactly one registry row, and
# every test a contract names exists. Installed by `aapp develop` only; adopter
# repositories never receive it, because they consume verbs and never add them.
#
# Runs only when a commit touches the registry, a contract or a verb suite, and
# delegates to tests/verb_contracts_test.sh so the check has a single owner.
# ==============================================================================
set -e

ROOT="$(git rev-parse --show-toplevel)"

TOUCHED="$(git diff --cached --name-only | grep -E '^(lib/verbs\.tsv|lib/docs/verbs/|tests/verbs/|tests/verb_contracts_test\.sh)' || true)"
[ -z "$TOUCHED" ] && exit 0

CHECK="$ROOT/tests/verb_contracts_test.sh"
if [ ! -f "$CHECK" ]; then
    echo "❌ [AAPP Develop] Contract check missing: $CHECK" >&2
    echo "   This engine belongs to the kit repository; remove .githooks/aapp-pre-commit-develop elsewhere." >&2
    exit 1
fi

if ! OUT="$(bash "$CHECK" 2>&1)"; then
    echo "" >&2
    echo "❌ [AAPP Develop] Verb contract correspondence failed (lib/verbs.tsv <-> lib/docs/verbs/):" >&2
    printf '%s\n' "$OUT" | grep -E "✘|^       " >&2
    echo "   Every daily verb needs a contract, and every test a contract names must exist." >&2
    echo "" >&2
    exit 1
fi
exit 0

#!/usr/bin/env perl
use strict;
use warnings;
use utf8;
use 5.026;

BEGIN {
    my $lib = $ENV{AAPP_LIB};
    if ( !defined $lib || $lib eq '' || !-d $lib ) {
        my $kd = `git config --get aapp.kitDir 2>/dev/null` =~ s/\s+\z//r;
        $lib = "$kd/lib" if $kd ne '';
    }
    if ( !defined $lib || $lib eq '' || !-d $lib ) {
        my $file = __FILE__;
        if ( !-f $file && defined $ENV{PWD} ) {
            $file = "$ENV{PWD}/$file";
        }
        my $parent = $file =~ s{/[^/]+$}{}r;
        if ( -f "$parent/../lib/AAPP/JSON.pm" ) {
            require Cwd;
            $lib = Cwd::abs_path("$parent/../lib");
        }
    }
    if ( !defined $lib || $lib eq '' || !-d $lib ) {
        my $data = $ENV{XDG_DATA_HOME};
        if ( !defined $data || $data eq '' ) {
            my $home = $ENV{HOME} // ( $^O eq 'MSWin32' ? $ENV{USERPROFILE} : undef );
            $data = "$home/.local/share" if defined $home;
        }
        $lib = "$data/aapp-kit/lib" if defined $data;
    }
    if ( !defined $lib || !-r "$lib/AAPP/JSON.pm" ) {
        print STDERR "❌ [Commit-Msg Violation] Perl core missing: perl and " . ( $lib // '' ) . "/AAPP/JSON.pm are required. Install the kit: aapp install.\n";
        exit 1;
    }
    unshift @INC, $lib;
}

use AAPP::Hooks::CommitMsg ();
exit AAPP::Hooks::CommitMsg->run(@ARGV);

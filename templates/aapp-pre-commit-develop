#!/usr/bin/env perl
use strict;
use warnings;
use utf8;
use 5.026;

BEGIN {
    # §2.1 item 5: Load AAPP::* from the installed kit ($AAPP_LIB, else kit_dir)
    my $lib = $ENV{AAPP_LIB};
    if ( !defined $lib || $lib eq '' ) {
        my $data = $ENV{XDG_DATA_HOME};
        if ( !defined $data || $data eq '' ) {
            my $home = $ENV{HOME};
            if ( ( !defined $home || $home eq '' ) && $^O eq 'MSWin32' ) {
                $home = $ENV{USERPROFILE};
            }
            $data = "$home/.local/share" if defined $home && $home ne '';
        }
        $lib = "$data/aapp-kit/lib" if defined $data && $data ne '';
    }
    if ( defined $lib && -d $lib && -r "$lib/AAPP/Paths.pm" ) {
        unshift @INC, $lib;
        require AAPP::Paths;
        my $kd = AAPP::Paths::kit_dir();
        if ( defined $kd && -d "$kd/lib" ) {
            $lib = "$kd/lib";
            unshift @INC, $lib unless $INC[0] eq $lib;
        }
    }
    if ( !defined $lib || !-r "$lib/AAPP/JSON.pm" ) {
        print STDERR "❌ [AAPP Guard] Perl core missing: perl and " . ( $lib // '' ) . "/AAPP/JSON.pm are required. Install the kit: aapp install.\n";
        exit 1;
    }
}

use AAPP::Hooks::PreCommitDevelop ();
exit AAPP::Hooks::PreCommitDevelop->run(@ARGV);

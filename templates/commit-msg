#!/usr/bin/env bash
# ==============================================================================
# Git Commit-Msg Hook (Project Master Entrypoint)
#
# Dispatches to AAPP commit-msg enforcement engine.
# ==============================================================================
set -e
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo ".git")"
PRIMARY_ROOT="$(cd "$COMMON_DIR/.." 2>/dev/null && pwd || true)"
HOOK_DIR="$PRIMARY_ROOT/.githooks"

# 1. AAPP Commit-Msg Enforcement Hook (must run first)
if [ -f "$HOOK_DIR/aapp-commit-msg" ]; then
    bash "$HOOK_DIR/aapp-commit-msg" "$@" || exit 1
elif [ -f "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/aapp-commit-msg" ]; then
    bash "$(git rev-parse --show-toplevel)/.githooks/aapp-commit-msg" "$@" || exit 1
fi


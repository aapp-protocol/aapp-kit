#!/bin/sh
# ==============================================================================
# Reference `aapp-issue-tracker` Provider Plugin (SAMPLE)
#
# Install at: .agents/skills/aapp-issue-tracker/run
#
# WHAT IT IS FOR
#   AAPP sends every issue step to this plugin, with the whole issue. The
#   plugin decides, part by part, what it handles; AAPP does the rest. A real
#   provider talks to your tracker (Jira, GitHub, a service of your own). This
#   sample keeps its record in a local file so every step can be tried.
#
# CONTRACT (Plugin Payload Standard; docs/reference/06-plugin-protocol.md,
#           docs/reference/07-issue-protocol.md)
#   stdin : JSON envelope
#           {"version","event","timestamp","actor",
#            "repository": {"root","branch","remote": {"name","url"} | null},
#            "data": {...}, "extra": {}}
#           Credentials are stripped from the remote URL; AAPP sends none.
#   env   : AAPP_ACTION (the step), AAPP_PLUGIN_STEP (the event), AAPP_ISSUE_ID
#   stdout: one flat JSON object:
#           "status"  : "ok" | "declined" | "failed" (absent on exit 0 means ok)
#           "message" : one sentence AAPP shows the user
#           "handled" : what this plugin took care of (description, notes, list)
#           "id"      : on issue.log, the issue's id: the tracker's own key or
#                       number ("PROJ-101", "101"). AAPP sends no id and takes
#                       this one; "ok" without it is refused.
#           "tracker", "url", "release": shown beside the issue, never interpreted
#   files : $AAPP_PLUGIN_LIST  one flat JSON object per line (issue.list: the
#                              open issues; issue.fix: the issue's notes)
#           $AAPP_PLUGIN_DO    aapp commands AAPP runs after the step, one per
#                              line; accepted: `issue close`, `issue abort`
#
#   event            data                                  what AAPP does on failure
#   issue.log        the issue, no id; description         refuses: nothing is logged
#   issue.refine     the issue; notes just added           carries on, warns
#   issue.fix        the issue                             carries on, warns
#   issue.fix-abort  the issue (still open)                carries on, warns
#   issue.abort      the issue; reason                     carries on, warns
#   issue.close      the issue; commit, summary, plan      carries on, warns
#   issue.list       open, limit, since, ids               shows what it has
#   issue.next-blocker  {}                                 refuses: nothing is claimed
#   issue.queue      the issue (queued for work)           refuses where the tracker keeps the record, else warns
#   issue.unqueue    the issue (off the work queue)        refuses where the tracker keeps the record, else warns
#
#   During a step this plugin cannot run a writing `aapp` verb itself; it has at
#   most aapp.pluginTimeout seconds (default 10). A tracker may have created a
#   ticket even when AAPP saw a timeout: recognising a repeated request (by a
#   hash of the payload it keeps) is the provider's own business.
#
# THE RECORD
#   A provider that answers `"handled": "list"` to issue.list keeps the record:
#   AAPP then stops committing its ledgers and brings them up to date from the
#   listing. This sample does so only when AAPP_SAMPLE_TRACKER_LISTS=1; without
#   it the committed ledgers stay the record and this sample only numbers and
#   mirrors the issues.
#
# WHY A REAL PROVIDER IS A ONE-LINE SHIM
#   Anything committed here is public, so the tracker endpoint and its
#   credentials live outside the repository. A real `run` is usually:
#       exec "$HOME/.local/bin/aapp-issue-tracker-provider" "$@"
# ==============================================================================
store="${AAPP_SAMPLE_TRACKER_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/aapp-sample-tracker/issues.tsv}"
mkdir -p "$(dirname "$store")" || { echo '{"status": "failed", "message": "the sample tracker cannot write its file"}'; exit 0; }
touch "$store"
envelope="$(cat | tr -d '\n')"
data="$(printf '%s' "$envelope" | sed -E 's/.*"data": *//; s/, *"extra": *\{\} *\} *$//')"
# field <name>: a text member of data.
field() { printf '%s' "$data" | sed -nE "s/.*\"$1\": *\"(([^\"\\\\]|\\\\.)*)\".*/\1/p"; }
id="$(field id)"

case "${AAPP_PLUGIN_STEP:-}" in
    issue.log)
        last="$(cut -f1 "$store" | tr -d '#' | sort -n | tail -n 1)"
        id="#$(( ${last:-0} + 1 ))"
        printf '%s\topen\t%s\t%s\t%s\t%s\t%s\n' "$id" "$(field sev)" "$(field type)" "$(field date)" "$(field location)" "$(field symptom)" >> "$store"
        printf '{"status": "ok", "id": "%s", "tracker": "sample"}\n' "$id"
        ;;
    issue.close|issue.abort)
        tmp="$store.tmp.$$"
        awk -F'\t' -v OFS='\t' -v id="$id" '$1 == id { $2 = "closed" } { print }' "$store" > "$tmp" && mv "$tmp" "$store"
        echo '{"status": "ok"}'
        ;;
    issue.list)
        if [ "${AAPP_SAMPLE_TRACKER_LISTS:-0}" != "1" ]; then echo '{"status": "declined"}'; exit 0; fi
        awk -F'\t' '{ printf "{\"id\": \"%s\", \"status\": \"%s\", \"sev\": \"%s\", \"type\": \"%s\", \"date\": \"%s\", \"location\": \"%s\", \"symptom\": \"%s\"}\n", $1, $2, $3, $4, $5, $6, $7 }' "$store" > "${AAPP_PLUGIN_LIST:-/dev/null}"
        echo '{"status": "ok", "handled": "list"}'
        ;;
    issue.next-blocker)
        echo '{"status": "declined"}'
        ;;
    *)
        echo '{"status": "ok"}'
        ;;
esac

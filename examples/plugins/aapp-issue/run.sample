#!/bin/sh
# ==============================================================================
# Reference `aapp-issue` Provider Plugin (MOCK)
#
# Install at: .agents/skills/aapp-issue/run
# Copy this directory as-is -- it already carries the canonical name.
#
# CONTRACT (AAPP_ACTION selects the call)
#   allocate : stdout one issue id, "#42" or bare "42"; exit 0 = issued,
#              exit !0 = refuse (AAPP aborts rather than allocating locally).
#   close    : AAPP_ISSUE_ID, AAPP_COMMIT_SHA, AAPP_SUMMARY describe a closure
#              AAPP already archived locally. Fire-and-forget: AAPP calls once
#              and only warns on failure. Retry, queueing and later delivery to
#              the tracker are this plugin's responsibility. Must be idempotent.
#
# WHY THIS IS A ONE-LINE SHIM
#   Same reasoning as examples/plugins/aapp-planid/run.sample: anything
#   committed here is public, so the tracker endpoint and credentials live in
#   the provider outside the repository. The default target sits in
#   ~/.local/bin/, which blast-radius-guard hard-denies to agents.
#
#   Override the target with AAPP_ISSUE_CMD.
# ==============================================================================
exec "${AAPP_ISSUE_CMD:-$HOME/.local/bin/aapp-issue-provider}" "$@"

#!/usr/bin/env bash
# ==============================================================================
# Adopter Showcase Action Plugin: `hello-tool/run`
#
# Demonstrates extension-agnostic action plugin discovery in AAPP.
# Placed in .agents/skills/hello-tool/run or examples/plugins/hello-tool/run.
#
# Executed directly via:
#   aapp hello-tool [args...]
# ==============================================================================
set -e

echo "👋 Hello from AAPP Action Plugin 'hello-tool'!"
echo "   Invoked with arguments: $*"
echo "   Working Directory      : $(pwd)"
echo "   Timestamp              : $(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)"

exit 0
